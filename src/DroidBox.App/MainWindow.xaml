<Window x:Class="DroidBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DroidBox.App"
        mc:Ignorable="d"
        Title="DroidBox — Instant Android VMs" Height="600" Width="960"
        Background="#1E1F26" Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2D2F3B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4C8BF5"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#B23B3B"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Android version:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="VersionCombo" Width="220" DisplayMemberPath="DisplayName" VerticalAlignment="Center"/>
            <Button x:Name="CreateButton" Content="+ Create VM" Style="{StaticResource PrimaryButton}"
                    Margin="16,0,0,0" Click="CreateButton_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.8"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="VmList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2C38" CornerRadius="10" Margin="0,0,16,16" Padding="16" Width="260"
                                AllowDrop="True"
                                Drop="VmCard_Drop"
                                DragOver="VmCard_DragOver"
                                Tag="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding StatusText}" Opacity="0.75" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                <Border BorderBrush="#4C5063" BorderThickness="1"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,12">
                                    <TextBlock Text="Drop .apk here to install" TextAlignment="Center" Opacity="0.6" TextWrapping="Wrap" FontSize="11"/>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Start" Style="{StaticResource ActionButton}"
                                            Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}"
                                            Click="StartButton_Click" Tag="{Binding}"/>
                                    <Button Content="Stop" Style="{StaticResource ActionButton}"
                                            Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}}"
                                            Click="StopButton_Click" Tag="{Binding}"/>
                                    <Button Content="Delete" Style="{StaticResource DangerButton}"
                                            Click="DeleteButton_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
